{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {"source": "/apps/chowcart", "destination": "/apps/chowcart/index.html"},
    {"source": "/apps/rentsmall", "destination": "/apps/rentsmall/index.html"},
    {"source": "/apps/waygo", "destination": "/apps/waygo/index.html"},
    {"source": "/apps/sureplug", "destination": "/apps/sureplug/index.html"},
    {"source": "/apps/workchop", "destination": "/apps/workchop/index.html"},
    {"source": "/apps/lightpadi", "destination": "/apps/lightpadi/index.html"},
    {"source": "/apps/pricepal", "destination": "/apps/pricepal/index.html"},
    {"source": "/apps/flipam", "destination": "/apps/flipam/index.html"},
    {"source": "/apps/shoppadi", "destination": "/apps/shoppadi/index.html"},
    {"source": "/apps/borrowbeta", "destination": "/apps/borrowbeta/index.html"}
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "X-Frame-Options", "value": "DENY"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
    ]
  }]
}
